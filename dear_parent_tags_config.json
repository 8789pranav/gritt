{
  "version": "1.0.0",
  "description": "Machine-readable tag definitions for Dear Parent cognitive profiling. Phase 2: per-test tagging engine.",

  "tests": {
    "logic_quest": {
      "display_name": "Logic Quest",
      "item_type_groups": {
        "pattern": ["pattern", "pattern_rule_id"],
        "relational": ["analogy", "odd_one_out", "categorization", "comparison"],
        "multistep": ["rule_application", "syllogism", "conditional_logic", "transitive_reasoning", "multi_step_quantity", "two_step", "sequencing", "order_of_operations"],
        "load": ["two_attribute_selection", "negation_two_attribute", "multi_step_quantity", "two_step"]
      },
      "derived_signals": [
        "pattern_score",
        "relational_score",
        "systematic_score",
        "load_fails",
        "rule_maintenance_fails",
        "shift_result",
        "rule_inferred",
        "multiple_attempts_count",
        "fast_and_wrong_count",
        "self_corrected_to_right_count"
      ],
      "tags": [
        {
          "id": "pattern_detection_strong",
          "trigger": "pattern_score >= 3 AND pattern_hard_count >= 1",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child demonstrates strong pattern recognition across multiple items including at least one hard item."
        },
        {
          "id": "pattern_detection_emerging",
          "trigger": "pattern_score >= 2",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child shows early pattern recognition but not yet consistent across hard items."
        },
        {
          "id": "relational_reasoning_present",
          "trigger": "relational_score >= 3",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child draws relationships between concepts effectively."
        },
        {
          "id": "systematic_problem_solving",
          "trigger": "systematic_score >= 3",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child applies step-by-step logical approaches to complex problems."
        },
        {
          "id": "cognitive_flexibility_intact",
          "trigger": "shift_result == shifted_ok",
          "confidence": "medium",
          "polarity": "strength",
          "description": "Child shifts strategy when the rule changes (observed via sort task)."
        },
        {
          "id": "flexible_strategy_use",
          "trigger": "rule_inferred == true",
          "confidence": "medium",
          "polarity": "strength",
          "description": "Child infers and uses a new rule independently."
        },
        {
          "id": "reasoning_under_load_emerging",
          "trigger": "load_fails >= 2",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child struggles holding multiple features or steps at once."
        },
        {
          "id": "strategy_shift_difficulty",
          "trigger": "shift_result == stuck",
          "confidence": "medium",
          "polarity": "growth_edge",
          "description": "Child stays stuck in the old rule after a change (observed via sort task)."
        },
        {
          "id": "rule_maintenance_difficulty",
          "trigger": "rule_maintenance_fails >= 2",
          "confidence": "low",
          "polarity": "growth_edge",
          "description": "Child struggles to reliably apply even a single filter rule. Flagged as low confidence on single items."
        },
        {
          "id": "trial_and_error_strategy",
          "trigger": "multiple_attempts_count >= 2",
          "confidence": "high",
          "polarity": "neutral",
          "description": "Child explores by trying rather than planning ahead."
        },
        {
          "id": "impulsive_response",
          "trigger": "fast_and_wrong_count >= 2",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child responds quickly without sufficient reflection, leading to errors."
        },
        {
          "id": "self_correction_present",
          "trigger": "self_corrected_to_right_count >= 1",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child catches and fixes their own mistakes."
        }
      ]
    },

    "word_wizard": {
      "display_name": "Word Wizard (Spelling)",
      "derived_signals": [
        "beginning_accuracy",
        "final_accuracy",
        "vowel_accuracy",
        "vowel_error_count",
        "digraph_accuracy",
        "blend_accuracy",
        "digraph_error_count",
        "sight_word_accuracy",
        "regular_word_accuracy",
        "improved_with_audio",
        "hard_words_attempted_ratio",
        "fast_slips"
      ],
      "tags": [
        {
          "id": "phonetic_strategy_strong",
          "trigger": "beginning_accuracy >= 0.8 AND final_accuracy >= 0.8 AND vowel_accuracy >= 0.7",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child decodes words using solid phonetic knowledge across all positions."
        },
        {
          "id": "vowel_accuracy_strong",
          "trigger": "vowel_error_count == 0",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child demonstrates mastery of short and long vowel patterns."
        },
        {
          "id": "vowel_difficulty_emerging",
          "trigger": "vowel_error_count >= 2",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child shows emerging difficulty with vowel patterns."
        },
        {
          "id": "digraph_blend_competent",
          "trigger": "digraph_accuracy >= 0.7 AND blend_accuracy >= 0.7",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child handles consonant digraphs and blends competently."
        },
        {
          "id": "digraph_difficulty_emerging",
          "trigger": "digraph_error_count >= 2",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child struggles with consonant digraph or blend patterns."
        },
        {
          "id": "sight_word_recognition_strong",
          "trigger": "sight_word_accuracy >= 0.8",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child recognizes high-frequency sight words reliably."
        },
        {
          "id": "sight_word_emerging",
          "trigger": "sight_word_accuracy < regular_word_accuracy AND sight_word_accuracy < 0.7",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child finds sight words harder than phonetically regular words."
        },
        {
          "id": "audio_support_benefit",
          "trigger": "improved_with_audio == true",
          "confidence": "high",
          "polarity": "neutral",
          "description": "Child performed better after hearing the word spoken aloud."
        },
        {
          "id": "confident_attempt",
          "trigger": "hard_words_attempted_ratio >= 0.8",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child attempts challenging words without giving up."
        },
        {
          "id": "rushed_spelling",
          "trigger": "fast_slips >= 2",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child makes careless errors on words they likely know due to speed."
        }
      ]
    },

    "voice_challenge": {
      "display_name": "Voice Challenge (Speaking)",
      "derived_signals": [
        "avg_fluency",
        "avg_pronunciation",
        "avg_prosody",
        "flat_delivery",
        "hard_band_avg"
      ],
      "tags": [
        {
          "id": "expressive_fluency_strong",
          "trigger": "avg_fluency >= 0.8",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child reads aloud with smooth, natural-sounding fluency."
        },
        {
          "id": "expressive_fluency_emerging",
          "trigger": "avg_fluency >= 0.6 AND avg_fluency < 0.8",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child's fluency is developing but not yet consistently smooth."
        },
        {
          "id": "pronunciation_accurate",
          "trigger": "avg_pronunciation >= 0.85",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child pronounces words accurately and clearly."
        },
        {
          "id": "pronunciation_developing",
          "trigger": "avg_pronunciation < 0.7",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child has notable pronunciation gaps that affect intelligibility."
        },
        {
          "id": "prosody_strong",
          "trigger": "avg_prosody >= 0.8",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child uses appropriate intonation, stress, and rhythm."
        },
        {
          "id": "prosody_emerging",
          "trigger": "flat_delivery == true",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child reads in a flat, monotone manner without natural expression."
        },
        {
          "id": "complex_syntax_confident",
          "trigger": "hard_band_avg >= 0.8",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child handles complex sentence structures with confidence."
        }
      ]
    },

    "story_explorer": {
      "display_name": "Story Explorer (Comprehension)",
      "derived_signals": [
        "literal_accuracy",
        "inferential_accuracy",
        "vocabulary_accuracy",
        "overall_accuracy",
        "literal_inferential_gap"
      ],
      "question_type_mapping": {
        "literal": "Questions about explicit story details (who, what, where, when)",
        "inferential": "Questions requiring reasoning beyond stated text (why, how, theme)",
        "vocabulary": "Questions about word meaning in context"
      },
      "tags": [
        {
          "id": "literal_comprehension_strong",
          "trigger": "literal_accuracy >= 0.8",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child recalls and identifies stated facts from the text accurately."
        },
        {
          "id": "inferential_comprehension_strong",
          "trigger": "inferential_accuracy >= 0.8",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child draws valid conclusions and inferences beyond the literal text."
        },
        {
          "id": "inferential_comprehension_emerging",
          "trigger": "inferential_accuracy < 0.6 AND literal_inferential_gap >= 0.3",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child understands literal content but struggles to infer meaning."
        },
        {
          "id": "vocabulary_in_context_strong",
          "trigger": "vocabulary_accuracy >= 0.8",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child determines word meanings from surrounding context effectively."
        },
        {
          "id": "vocabulary_in_context_emerging",
          "trigger": "vocabulary_accuracy < 0.6",
          "confidence": "high",
          "polarity": "growth_edge",
          "description": "Child has difficulty determining word meaning from context."
        },
        {
          "id": "listening_comprehension_strong",
          "trigger": "overall_accuracy >= 0.75",
          "confidence": "high",
          "polarity": "strength",
          "description": "Child demonstrates strong understanding of audio-narrated stories."
        }
      ]
    }
  },

  "thresholds": {
    "latency_multiplier_for_over_time": 1.5,
    "fast_response_ratio_for_impulsive": 0.5,
    "borderline_score_low": 0.55,
    "borderline_score_high": 0.65,
    "min_sentences_for_speaking_tag": 3
  },

  "synthesis_rules": {
    "low_confidence_weight": 0.3,
    "high_confidence_weight": 1.0,
    "min_tags_for_headline": 2,
    "never_standalone_if_low_confidence": true
  }
}
