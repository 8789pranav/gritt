{
  "schema_version": "1.0",
  "test": "spelling",
  "test_key": "word_wizard",
  "display_name": "Word Wizard (Spelling)",
  "description": "Cognitive tag definitions for the Word Wizard spelling assessment.",
  "derived_signals": [
    "beginning_accuracy",
    "final_accuracy",
    "vowel_accuracy",
    "vowel_error_count",
    "vowel_words_count",
    "digraph_accuracy",
    "blend_accuracy",
    "digraph_error_count",
    "blend_error_count",
    "digraph_words_count",
    "blend_words_count",
    "sight_word_accuracy",
    "sight_words_count",
    "regular_word_accuracy",
    "convention_error_count",
    "improved_with_audio",
    "hard_words_attempted_ratio",
    "fast_slips"
  ],
  "tags": [
    {
      "id": "phonetic_strategy_strong",
      "trigger": "beginning_accuracy >= 0.8 AND final_accuracy >= 0.8 AND vowel_accuracy >= 0.75",
      "confidence": "high",
      "polarity": "strength",
      "description": "Child decodes words using solid phonetic knowledge across all positions."
    },
    {
      "id": "vowel_accuracy_strong",
      "trigger": "vowel_error_count == 0 AND vowel_words_count >= 1",
      "confidence": "high",
      "polarity": "strength",
      "description": "Child demonstrates mastery of short and long vowel patterns."
    },
    {
      "id": "vowel_emerging",
      "trigger": "vowel_accuracy < 0.75 AND vowel_words_count >= 1",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Child shows emerging difficulty with vowel patterns."
    },
    {
      "id": "digraph_competent",
      "trigger": "digraph_accuracy >= 1.0 AND digraph_words_count >= 2",
      "confidence": "high",
      "polarity": "strength",
      "description": "Child handles consonant digraphs competently."
    },
    {
      "id": "blend_competent",
      "trigger": "blend_accuracy >= 1.0 AND blend_words_count >= 2",
      "confidence": "high",
      "polarity": "strength",
      "description": "Child handles consonant blends competently."
    },
    {
      "id": "digraph_emerging",
      "trigger": "digraph_accuracy < 0.75 AND digraph_words_count >= 1",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Child struggles with consonant digraph patterns."
    },
    {
      "id": "blend_emerging",
      "trigger": "blend_accuracy < 0.75 AND blend_words_count >= 1",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Child struggles with consonant blend patterns."
    },
    {
      "id": "sight_word_recognition_strong",
      "trigger": "sight_word_accuracy >= 1.0 AND sight_words_count >= 1",
      "confidence": "high",
      "polarity": "strength",
      "description": "Child recognizes high-frequency sight words reliably."
    },
    {
      "id": "sight_word_emerging",
      "trigger": "sight_word_accuracy < 0.75 AND sight_words_count >= 1",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Child finds sight words harder than phonetically regular words."
    },
    {
      "id": "spelling_convention_emerging",
      "trigger": "convention_error_count >= 3",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Child hears the sounds in words but does not yet know the spelling rules."
    },
    {
      "id": "audio_support_benefit",
      "trigger": "improved_with_audio == true",
      "confidence": "high",
      "polarity": "neutral",
      "description": "Child performed better after hearing the word spoken aloud."
    },
    {
      "id": "rushed_spelling",
      "trigger": "fast_slips >= 2",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Child answers quickly on words they have not yet mastered."
    }
  ]
}
