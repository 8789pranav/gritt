{
  "schema_version": "1.0",
  "test": "logic",
  "test_key": "logic_quest",
  "display_name": "Logic Quest",
  "description": "Cognitive tag definitions for the Logic Quest reasoning assessment.",
  "item_type_groups": {
    "pattern": [
      "pattern",
      "pattern_rule_id",
      "meta_categorization"
    ],
    "relational": [
      "analogy",
      "odd_one_out",
      "categorization",
      "comparison",
      "double_analogy",
      "syllogism"
    ],
    "multistep": [
      "rule_application",
      "conditional_logic",
      "transitive_reasoning",
      "multi_step_quantity",
      "two_step",
      "sequencing",
      "order_of_operations",
      "combining",
      "rule_boundary",
      "dual_rule_arithmetic",
      "strategic_search"
    ],
    "flexibility": [
      "strategy",
      "dual_rule",
      "dual_condition",
      "meta_strategy"
    ],
    "load": [
      "two_attribute_selection",
      "negation_two_attribute",
      "multi_step_quantity",
      "two_step",
      "transitive_reasoning"
    ],
    "rule_application": [
      "conditional_logic",
      "rule_application",
      "two_step",
      "rule_boundary",
      "dual_rule",
      "dual_rule_arithmetic",
      "dual_condition"
    ]
  },
  "derived_signals": [
    "pattern_accuracy",
    "pattern_items_count",
    "pattern_hard_count",
    "relational_accuracy",
    "relational_items_count",
    "systematic_accuracy",
    "systematic_items_count",
    "flexibility_accuracy",
    "flexibility_items_count",
    "load_accuracy",
    "load_items_count",
    "load_fails",
    "rule_maintenance_fails",
    "multiple_attempts_count",
    "fast_and_wrong_count",
    "self_corrected_to_right_count",
    "rule_maintenance_items_count",
    "rule_maintenance_accuracy",
    "slow_and_correct_count"
  ],
  "tags": [
    {
      "id": "pattern_detection_strong",
      "trigger": "pattern_accuracy >= 0.75 AND pattern_items_count >= 3",
      "confidence": "high",
      "polarity": "strength",
      "description": "Your child recognises patterns confidently."
    },
    {
      "id": "pattern_detection_emerging",
      "trigger": "pattern_accuracy < 0.75 AND pattern_items_count >= 3",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Your child is beginning to recognise patterns. With more practice they will tackle harder ones too."
    },
    {
      "id": "relational_reasoning_present",
      "trigger": "relational_accuracy >= 0.75 AND relational_items_count >= 3",
      "confidence": "high",
      "polarity": "strength",
      "description": "Your child connects ideas and sees how different concepts relate to each other."
    },
    {
      "id": "relational_reasoning_emerging",
      "trigger": "relational_accuracy < 0.75 AND relational_items_count >= 3",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Your child is starting to see how ideas connect. Comparing and sorting everyday objects together will help."
    },
    {
      "id": "systematic_problem_solving",
      "trigger": "systematic_accuracy >= 0.75 AND systematic_items_count >= 3",
      "confidence": "high",
      "polarity": "strength",
      "description": "Your child breaks down complex problems into manageable steps."
    },
    {
      "id": "systematic_problem_solving_emerging",
      "trigger": "systematic_accuracy < 0.75 AND systematic_items_count >= 3",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Your child is learning to work through problems one step at a time rather than jumping to an answer."
    },
    {
      "id": "flexible_strategy_use",
      "trigger": "flexibility_accuracy >= 0.75 AND flexibility_items_count >= 3",
      "confidence": "medium",
      "polarity": "strength",
      "description": "Your child tries different strategies and adapts their approach when needed."
    },
    {
      "id": "flexible_strategy_emerging",
      "trigger": "flexibility_accuracy < 0.75 AND flexibility_items_count >= 3",
      "confidence": "medium",
      "polarity": "growth_edge",
      "description": "Your child tends to stay with the first approach they try. Puzzles with more than one route to the answer will help."
    },
    {
      "id": "reasoning_under_load",
      "trigger": "load_accuracy >= 0.75 AND load_items_count >= 3",
      "confidence": "high",
      "polarity": "strength",
      "description": "Your child holds several pieces of information in mind at once and works through them."
    },
    {
      "id": "reasoning_under_load_emerging",
      "trigger": "load_accuracy < 0.75 AND load_items_count >= 3 AND load_fails >= 1",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Your child is developing the ability to hold several pieces of information in mind at once. Practice with multi-step puzzles will help."
    },
    {
      "id": "rule_maintenance_difficulty",
      "trigger": "rule_maintenance_accuracy < 0.75 AND rule_maintenance_items_count >= 3",
      "confidence": "medium",
      "polarity": "growth_edge",
      "description": "Your child is still learning to apply a single rule consistently. This is common at this stage and will improve with sorting games."
    },
    {
      "id": "deliberate_pace",
      "trigger": "slow_and_correct_count >= 2",
      "confidence": "medium",
      "polarity": "neutral",
      "description": "Your child takes their time on the harder questions and works them out rather than guessing."
    },
    {
      "id": "trial_and_error_strategy",
      "trigger": "multiple_attempts_count >= 2",
      "confidence": "high",
      "polarity": "neutral",
      "description": "Your child explores by trying different answers rather than planning ahead. This is a natural stage of learning."
    },
    {
      "id": "impulsive_response",
      "trigger": "fast_and_wrong_count >= 2",
      "confidence": "high",
      "polarity": "growth_edge",
      "description": "Some answers were given very quickly compared to your child's usual pace. Encouraging a brief pause before responding may help reduce these slips."
    },
    {
      "id": "self_correction_present",
      "trigger": "self_corrected_to_right_count >= 1",
      "confidence": "high",
      "polarity": "strength",
      "description": "Your child notices and corrects their own mistakes, which is a valuable learning skill."
    }
  ]
}
