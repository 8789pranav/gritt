
# Environment variables
.env

# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml

# Python
__pycache__/
*.pyc
venv/

# Generated Learning Snapshots. `scripts/generate_sample_letters.py` writes
# them, they cost a model call each, and they are a record of one run rather
# than something to review in a diff.
sample_letters/
sample_letters_live/

# Records pulled out of the live database before a manual repair. They are
# one parent's child, by name, and they belong on the machine that made the
# repair rather than in the history of the project.
scripts/_backups/
